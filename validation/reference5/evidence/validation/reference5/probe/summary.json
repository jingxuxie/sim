      ],
      "region": "Right-hand wall of the optical support enclosure",
      "observed": "Two elongated guide slots have rounded ends and visible interior depth.",
      "prior_error": "Rectangular openings had shallow backing strips; the native upright was a solid box across both openings.",
      "correction": "Rebuilt side shells with through-cut rounded slots, removed the backing strips, and replaced the monolithic contact hull with open compound shell contacts."
    },
    {
      "photos": [
        245,
        247
      ],
      "region": "Lower optical-head side cover below the magnification selector",
      "observed": "A framed removable cover has two horizontal access slots and recessed faces.",
      "prior_error": "The apparent slots were immediately backed by a solid casing and a full-size collision hull.",
      "correction": "Cut bounded service wells into the casing, rebuilt the recessed cover/perimeter and real plate slots, and split contact pieces around the openings."
    },
    {
      "photos": [
        245,
        247
      ],
      "region": "Exposed lower guide-rod end",
      "observed": "The rod has a visible hollow end.",
      "correction": "Replaced the painted end mark with a short actual recessed bore."
